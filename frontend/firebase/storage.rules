rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // X-ray images — only the owning doctor can access
    match /xrays/{doctorId}/{patientId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == doctorId;
      allow write: if request.auth != null
                   && request.auth.uid == doctorId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Reports — only the owning doctor
    match /reports/{doctorId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == doctorId;
      allow write: if request.auth != null
                   && request.auth.uid == doctorId
                   && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
